/* Luma - minimal baseline styling. Refined in a later pass. */

#main-body {
    padding: 1 2;
    height: 1fr;
}

#tagline {
    color: $text-muted;
    margin-bottom: 1;
}

#link-row {
    height: auto;
    margin-bottom: 1;
}

#url-input {
    width: 1fr;
}

#download-btn {
    margin-left: 2;
}

#plan-panel {
    color: $text-muted;
    height: auto;
}

#downloads {
    height: 1fr;
}

#status-line {
    color: $text-muted;
    height: auto;
}

#settings-body,
#history-body {
    padding: 0 2;
    height: 1fr;
}

#settings-title,
#history-title {
    text-style: bold;
    padding: 1 2 0 2;
    height: auto;
}

#history-placeholder {
    color: $text-muted;
    margin-bottom: 1;
}

/* -- settings fields -- */

.setting {
    height: auto;
    margin-bottom: 1;
}

.setting Label {
    color: $text-muted;
}

.setting-switch {
    height: auto;
    align-vertical: middle;
}

.setting-switch Label {
    margin-left: 1;
    color: $foreground;
}

.field-error {
    color: $error;
    height: auto;
}

Input.-invalid {
    border: tall $error;
}

#settings-actions {
    height: auto;
    padding: 0 2 1 2;
}

#settings-actions Button {
    margin-right: 2;
}

#settings-message {
    color: $warning;
    height: auto;
    padding: 0 2;
}
