Screen {
    background: $background;
}

BrandBar {
    height: 1;
    background: $surface;
    padding: 0 2;
}

Screen.-narrow BrandBar {
    padding: 0 1;
}

Screen.-roomy BrandBar {
    padding: 0 4;
}

BrandBar > Horizontal {
    height: 1;
}

.brand-mark {
    color: $accent;
    text-style: bold;
    width: auto;
}

.brand-note {
    color: $text-muted;
    width: 1fr;
    text-align: right;
    text-overflow: ellipsis;
}

Screen.-narrow .brand-note {
    display: none;
}

Footer {
    background: $surface;
}

FooterKey .footer-key--key {
    color: $accent;
    text-style: bold;
}

#main-body {
    padding: 1 2;
    height: 1fr;
}

Screen.-narrow #main-body {
    padding: 0 1;
}

Screen.-roomy #main-body {
    padding: 1 4;
}

#link-row {
    height: auto;
    margin-bottom: 1;
}

Screen.-short #link-row {
    margin-bottom: 0;
}

#url-input {
    width: 1fr;
    border: tall $panel;
    background: $surface;
}

#url-input:focus {
    border: tall $accent;
}

#download-btn {
    margin-left: 2;
    min-width: 14;
}

Screen.-narrow #download-btn {
    margin-left: 1;
    min-width: 3;
}

#list-header {
    height: auto;
    align-vertical: middle;
}

#queue-note {
    color: $text-muted;
    text-style: italic;
    width: 1fr;
    height: 3;
    content-align: left middle;
}

#sort-select {
    width: 26;
}

Screen.-narrow #sort-select {
    width: 24;
}

#downloads {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#status-row {
    height: auto;
    align-vertical: middle;
    padding-top: 1;
    border-top: hkey $panel;
}

Screen.-short #status-row {
    padding-top: 0;
}

#busy {
    width: 4;
    height: 1;
    color: $accent;
}

#status-line {
    color: $text-muted;
    height: auto;
    width: 1fr;
}

#plan-note {
    color: $text-muted;
    height: auto;
    width: auto;
    margin-right: 2;
}

Screen.-narrow #plan-note {
    display: none;
}

#stop-btn {
    min-width: 8;
    height: 1;
    border: none;
    background: $error 40%;
    color: $foreground;
    margin-right: 1;
}

#stop-btn:hover,
#stop-btn:focus {
    background: $error;
}

#clear-btn {
    min-width: 13;
    height: 1;
    border: none;
    background: $panel;
    color: $text-muted;
}

#clear-btn:hover,
#clear-btn:focus {
    background: $boost;
    color: $foreground;
}

DownloadRow {
    height: auto;
    margin-bottom: 1;
    padding: 0 2;
    background: $surface;
    border-left: outer $panel;
}

Screen.-narrow DownloadRow {
    padding: 0 1;
}

Screen.-roomy DownloadRow {
    padding: 1 2 0 2;
}

DownloadRow > Horizontal {
    height: auto;
}

DownloadRow .row-main {
    height: auto;
    width: 1fr;
}

DownloadRow .row-title {
    text-overflow: ellipsis;
    text-style: bold;
}

DownloadRow .row-detail {
    color: $text-muted;
}

DownloadRow ProgressBar {
    width: 100%;
    height: 1;
}

DownloadRow Bar > .bar--bar {
    color: $accent;
}

DownloadRow Bar > .bar--complete {
    color: $success;
}

DownloadRow PercentageStatus {
    color: $text-muted;
}

DownloadRow .row-remove {
    min-width: 3;
    width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
    margin-left: 1;
}

DownloadRow .row-remove:hover,
DownloadRow .row-remove:focus {
    background: $error;
    color: $foreground;
}

DownloadRow.-choosing {
    border-left: outer $accent;
}

DownloadRow.-choosing .row-detail {
    color: $accent;
}

DownloadRow.-choosing ProgressBar {
    display: none;
}

DownloadRow .row-choices {
    height: 1;
    width: 1fr;
}

Screen.-roomy DownloadRow .row-choices {
    margin-top: 1;
}

.quality-chip {
    height: 1;
    width: auto;
    min-width: 6;
    border: none;
    padding: 0 2;
    margin-right: 1;
    background: $panel;
    color: $foreground;
}

Screen.-narrow .quality-chip {
    padding: 0 1;
}

.quality-chip:hover {
    background: $boost;
}

.quality-chip:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.quality-chip.-skip {
    color: $text-muted;
    background: transparent;
}

.quality-chip.-skip:focus {
    background: $panel;
    color: $foreground;
}

DownloadRow.-done {
    border-left: outer $success;
}

DownloadRow.-done .row-title {
    color: $success;
}

DownloadRow.-done Bar > .bar--bar {
    color: $success;
}

DownloadRow.-failed {
    border-left: outer $error;
}

DownloadRow.-failed .row-title {
    color: $error;
}

DownloadRow.-failed .row-detail {
    color: $error;
}

DownloadRow.-just-finished {
    background: $boost;
}

#settings-body,
#history-body {
    padding: 0 2;
    height: 1fr;
}

Screen.-narrow #settings-body,
Screen.-narrow #history-body {
    padding: 0 1;
}

Screen.-roomy #settings-body,
Screen.-roomy #history-body {
    padding: 0 4;
}

#settings-title,
#history-title {
    text-style: bold;
    color: $accent;
    padding: 1 2;
    height: auto;
}

Screen.-narrow #settings-title,
Screen.-narrow #history-title {
    padding: 0 1;
}

Screen.-roomy #settings-title,
Screen.-roomy #history-title {
    padding: 1 4;
}

.setting {
    height: auto;
    margin-bottom: 1;
}

Screen.-short .setting {
    margin-bottom: 0;
}

.setting Label {
    color: $text-muted;
}

.setting Input {
    border: tall $panel;
    background: $surface;
}

.setting Input:focus {
    border: tall $accent;
}

.setting-switch {
    height: auto;
    align-vertical: middle;
}

.setting-switch Label {
    margin-left: 1;
    color: $foreground;
    height: 3;
    content-align: left middle;
}

.field-error {
    color: $error;
    height: auto;
}

Input.-invalid {
    border: tall $error;
}

#settings-actions {
    height: auto;
    padding: 1 2;
    border-top: hkey $panel;
}

Screen.-narrow #settings-actions {
    padding: 0 1;
}

Screen.-roomy #settings-actions {
    padding: 1 4;
}

#settings-actions Button {
    margin-right: 2;
}

#settings-message {
    color: $warning;
    height: auto;
    padding: 0 2;
}

#history-tabs {
    height: 1fr;
}

#history-table,
#errors-table {
    height: 1fr;
    background: $surface;
}

.empty-note {
    color: $text-muted;
    text-style: italic;
    padding: 1 2;
    height: auto;
}

#history-back {
    margin: 1 2;
}
