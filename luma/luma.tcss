/* Luma - minimal baseline styling. Refined in a later pass. */

#main-body {
    padding: 1 2;
    height: 1fr;
}

#tagline {
    color: $text-muted;
    margin-bottom: 1;
}

#link-row {
    height: auto;
    margin-bottom: 1;
}

#url-input {
    width: 1fr;
}

#download-btn {
    margin-left: 2;
}

#plan-panel {
    color: $text-muted;
    height: auto;
}

#downloads {
    height: 1fr;
}

#status-line {
    color: $text-muted;
    height: auto;
}

#settings-body,
#history-body {
    padding: 1 2;
    height: 1fr;
}

#settings-title,
#history-title {
    text-style: bold;
    margin-bottom: 1;
}

#settings-placeholder,
#history-placeholder {
    color: $text-muted;
    margin-bottom: 1;
}
