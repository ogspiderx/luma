/* ------------------------------------------------------------------ *
 *  Luma
 *
 *  Light falling in a dark room. The ground stays deep and quiet; the
 *  brand colour is spent only on what is actually happening -- the bar
 *  as it fills, the box under the cursor, the question being asked --
 *  so the eye goes to the work rather than to the furniture.
 *
 *  Every colour comes from the active theme, and every theme is built
 *  from branding.py, so re-skinning the app never means editing this
 *  file.
 *
 *  SPACING SCALE. One scale, three sizes, applied from the outside in.
 *  Screens carry -narrow / -roomy / -short (see widgets/sizing.py), and
 *  only the gutter and the block gap change between them. Nothing sets
 *  a padding for itself; that is what made the old layout look like a
 *  different app at every window size.
 *
 *      gutter     1 / 2 / 4 columns   the margin down each side
 *      block gap  1 line              between one thing and the next
 *      row gap    1 line              between downloads in the list
 *
 *  MOTION. Three places, each tied to something being waited on: the
 *  spinner while preparing, the bar filling, and a brief highlight as a
 *  download lands. Idle screens do not move.
 * ------------------------------------------------------------------ */

Screen {
    background: $background;
}

/* -- the bar across the top -- */

BrandBar {
    height: 1;
    background: $surface;
    padding: 0 2;
}

Screen.-narrow BrandBar {
    padding: 0 1;
}

Screen.-roomy BrandBar {
    padding: 0 4;
}

BrandBar > Horizontal {
    height: 1;
}

.brand-mark {
    color: $accent;
    text-style: bold;
    width: auto;
}

/* One useful fact, never a decoration: on the main screen, where videos
   are being saved. It is the first thing to go when space is short. */
.brand-note {
    color: $text-muted;
    width: 1fr;
    text-align: right;
    text-overflow: ellipsis;
}

Screen.-narrow .brand-note {
    display: none;
}

/* -- the bar across the bottom -- */

Footer {
    background: $surface;
}

FooterKey .footer-key--key {
    color: $accent;
    text-style: bold;
}

/* -- main screen -- */

#main-body {
    padding: 1 2;
    height: 1fr;
}

Screen.-narrow #main-body {
    padding: 0 1;
}

Screen.-roomy #main-body {
    padding: 1 4;
}

#link-row {
    height: auto;
    margin-bottom: 1;
}

Screen.-short #link-row {
    margin-bottom: 0;
}

/* The box you type in is the one thing always worth finding. */
#url-input {
    width: 1fr;
    border: tall $panel;
    background: $surface;
}

#url-input:focus {
    border: tall $accent;
}

#download-btn {
    margin-left: 2;
    min-width: 14;
}

Screen.-narrow #download-btn {
    margin-left: 1;
    min-width: 3;
}

/* -- the list header: how many, and how to arrange them -- */

#list-header {
    height: auto;
    align-vertical: middle;
}

#queue-note {
    color: $text-muted;
    text-style: italic;
    width: 1fr;
    height: 3;
    content-align: left middle;
}

#sort-select {
    width: 26;
}

Screen.-narrow #sort-select {
    width: 24;
}

#downloads {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

/* A hairline above the status line, so the list ends at an edge rather
   than running into the footer. */
#status-row {
    height: auto;
    align-vertical: middle;
    padding-top: 1;
    border-top: hkey $panel;
}

Screen.-short #status-row {
    padding-top: 0;
}

/* The spinner is only mounted-visible while work is in flight. */
#busy {
    width: 4;
    height: 1;
    color: $accent;
}

#status-line {
    color: $text-muted;
    height: auto;
    width: 1fr;
}

/* How the download is being run. Worth knowing, worth nothing more. */
#plan-note {
    color: $text-muted;
    height: auto;
    width: auto;
    margin-right: 2;
}

Screen.-narrow #plan-note {
    display: none;
}

#stop-btn {
    min-width: 8;
    height: 1;
    border: none;
    background: $error 40%;
    color: $foreground;
    margin-right: 1;
}

#stop-btn:hover,
#stop-btn:focus {
    background: $error;
}

#clear-btn {
    min-width: 13;
    height: 1;
    border: none;
    background: $panel;
    color: $text-muted;
}

#clear-btn:hover,
#clear-btn:focus {
    background: $boost;
    color: $foreground;
}

/* -- a download in the list -- */

DownloadRow {
    height: auto;
    margin-bottom: 1;
    padding: 0 2;
    background: $surface;
    border-left: outer $panel;
}

Screen.-narrow DownloadRow {
    padding: 0 1;
}

Screen.-roomy DownloadRow {
    padding: 1 2 0 2;
}

/* The inner containers must size to their contents. Left to their default
   they claim all remaining space, and a single row then fills the pane. */
DownloadRow > Horizontal {
    height: auto;
}

DownloadRow .row-main {
    height: auto;
    width: 1fr;
}

DownloadRow .row-title {
    text-overflow: ellipsis;
    text-style: bold;
}

DownloadRow .row-detail {
    color: $text-muted;
}

DownloadRow ProgressBar {
    width: 100%;
    height: 1;
}

DownloadRow Bar > .bar--bar {
    color: $accent;
}

DownloadRow Bar > .bar--complete {
    color: $success;
}

DownloadRow PercentageStatus {
    color: $text-muted;
}

/* The cross that removes a row, or stops it if it is still going. */
DownloadRow .row-remove {
    min-width: 3;
    width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
    margin-left: 1;
}

DownloadRow .row-remove:hover,
DownloadRow .row-remove:focus {
    background: $error;
    color: $foreground;
}

/* -- being asked which quality, in the row itself -- */

/* A row with a question in it is the only thing on screen wearing the
   brand colour on its edge, so it is found without being announced. */
DownloadRow.-choosing {
    border-left: outer $accent;
}

DownloadRow.-choosing .row-detail {
    color: $accent;
}

/* The bar means nothing until there is something to measure. */
DownloadRow.-choosing ProgressBar {
    display: none;
}

/* The chips sit on their own line, spaced like everything else: a clear
   line above them only where there is room for one. */
DownloadRow .row-choices {
    height: 1;
    width: 1fr;
}

Screen.-roomy DownloadRow .row-choices {
    margin-top: 1;
}

.quality-chip {
    height: 1;
    width: auto;
    min-width: 6;
    border: none;
    padding: 0 2;
    margin-right: 1;
    background: $panel;
    color: $foreground;
}

Screen.-narrow .quality-chip {
    padding: 0 1;
}

.quality-chip:hover {
    background: $boost;
}

.quality-chip:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.quality-chip.-skip {
    color: $text-muted;
    background: transparent;
}

.quality-chip.-skip:focus {
    background: $panel;
    color: $foreground;
}

/* -- how a row ends -- */

DownloadRow.-done {
    border-left: outer $success;
}

DownloadRow.-done .row-title {
    color: $success;
}

DownloadRow.-done Bar > .bar--bar {
    color: $success;
}

DownloadRow.-failed {
    border-left: outer $error;
}

DownloadRow.-failed .row-title {
    color: $error;
}

DownloadRow.-failed .row-detail {
    color: $error;
}

/* One-shot highlight as a row lands. Removed on a timer, so nothing
   continues to animate afterwards. */
DownloadRow.-just-finished {
    background: $boost;
}

/* -- shared screen furniture -- */

#settings-body,
#history-body {
    padding: 0 2;
    height: 1fr;
}

Screen.-narrow #settings-body,
Screen.-narrow #history-body {
    padding: 0 1;
}

Screen.-roomy #settings-body,
Screen.-roomy #history-body {
    padding: 0 4;
}

#settings-title,
#history-title {
    text-style: bold;
    color: $accent;
    padding: 1 2;
    height: auto;
}

Screen.-narrow #settings-title,
Screen.-narrow #history-title {
    padding: 0 1;
}

Screen.-roomy #settings-title,
Screen.-roomy #history-title {
    padding: 1 4;
}

/* -- settings -- */

.setting {
    height: auto;
    margin-bottom: 1;
}

Screen.-short .setting {
    margin-bottom: 0;
}

.setting Label {
    color: $text-muted;
}

.setting Input {
    border: tall $panel;
    background: $surface;
}

.setting Input:focus {
    border: tall $accent;
}

.setting-switch {
    height: auto;
    align-vertical: middle;
}

.setting-switch Label {
    margin-left: 1;
    color: $foreground;
    height: 3;
    content-align: left middle;
}

.field-error {
    color: $error;
    height: auto;
}

Input.-invalid {
    border: tall $error;
}

#settings-actions {
    height: auto;
    padding: 1 2;
    border-top: hkey $panel;
}

Screen.-narrow #settings-actions {
    padding: 0 1;
}

Screen.-roomy #settings-actions {
    padding: 1 4;
}

#settings-actions Button {
    margin-right: 2;
}

#settings-message {
    color: $warning;
    height: auto;
    padding: 0 2;
}

/* -- history -- */

#history-tabs {
    height: 1fr;
}

#history-table,
#errors-table {
    height: 1fr;
    background: $surface;
}

.empty-note {
    color: $text-muted;
    text-style: italic;
    padding: 1 2;
    height: auto;
}

#history-back {
    margin: 1 2;
}
