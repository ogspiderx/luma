/* ------------------------------------------------------------------ *
 *  Luma
 *
 *  The idea is light falling in a dark room. The background stays deep
 *  and quiet; gold is spent only on what is actually happening -- the
 *  bar as it fills, the box under the cursor, the key hints -- so the
 *  eye is drawn to the work rather than to the furniture.
 *
 *  Every colour comes from the active theme, so choosing a different
 *  one in Settings re-tints the whole app rather than fighting it.
 *
 *  Motion is limited to three places, each tied to something the user
 *  is waiting on: the spinner while preparing, the bar filling, and a
 *  brief highlight when a download lands. Idle screens do not move.
 * ------------------------------------------------------------------ */

Screen {
    background: $background;
}

/* -- the bar across the top -- */

Header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}

Footer {
    background: $surface;
}

FooterKey .footer-key--key {
    color: $accent;
    text-style: bold;
}

/* -- main screen -- */

/* Generous gutters. The list is the busiest thing on screen, so the room
   around it is what stops it reading as a wall. */
#main-body {
    padding: 1 4;
    height: 1fr;
}

#tagline {
    color: $text-muted;
    margin-bottom: 1;
}

/* The box already carries a tall border, so one clear line below it is
   enough -- the room is better spent further down, around the list. */
#link-row {
    height: auto;
    margin-bottom: 1;
}

/* The box you type in is the one thing always worth finding. */
#url-input {
    width: 1fr;
    border: tall $panel;
    background: $surface;
}

#url-input:focus {
    border: tall $accent;
}

#download-btn {
    margin-left: 2;
    min-width: 14;
}

/* A quiet slab of facts, set apart from the list below it. */
#plan-panel {
    color: $text-muted;
    height: auto;
    padding: 0 2;
    border-left: outer $secondary;
    margin-bottom: 2;
}

/* -- the list header: how many, and how to arrange them -- */

#list-header {
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    align-vertical: middle;
}

/* Sat level with the middle of the chooser beside it, rather than riding
   up against its top border. */
#queue-note {
    color: $text-muted;
    text-style: italic;
    width: 1fr;
    height: 3;
    content-align: left middle;
}

#sort-select {
    width: 26;
}

#downloads {
    height: 1fr;
    scrollbar-size-vertical: 1;
    padding-right: 1;
}

/* A hairline above the status line, so the list has an edge to end at
   rather than running straight into the footer. */
#status-row {
    height: auto;
    align-vertical: middle;
    padding: 1 1 0 1;
    border-top: hkey $panel;
}

/* The spinner is only mounted-visible while work is in flight. */
#busy {
    width: 4;
    height: 1;
    color: $accent;
}

#status-line {
    color: $text-muted;
    height: auto;
    width: 1fr;
}

#stop-btn {
    min-width: 8;
    height: 1;
    border: none;
    background: $error 40%;
    color: $foreground;
    margin-right: 1;
}

#stop-btn:hover {
    background: $error;
}

#clear-btn {
    min-width: 13;
    height: 1;
    border: none;
    background: $panel;
    color: $text-muted;
}

#clear-btn:hover {
    background: $boost;
    color: $foreground;
}

/* -- a download in the list -- */

/* Air above the title and a clear gap below the row: three lines of text
   packed edge to edge is what made a long list hard to read. */
DownloadRow {
    height: auto;
    margin-bottom: 1;
    padding: 1 2 0 2;
    background: $surface;
    border-left: outer $panel;
}

/* The inner containers must size to their contents. Left to their default
   they claim all remaining space, and a single row then fills the pane. */
DownloadRow > Horizontal {
    height: auto;
}

DownloadRow .row-main {
    height: auto;
    width: 1fr;
}

DownloadRow .row-title {
    text-overflow: ellipsis;
    text-style: bold;
}

DownloadRow .row-detail {
    color: $text-muted;
}

DownloadRow ProgressBar {
    width: 100%;
    height: 1;
}

DownloadRow Bar > .bar--bar {
    color: $accent;
}

DownloadRow Bar > .bar--complete {
    color: $success;
}

DownloadRow PercentageStatus {
    color: $text-muted;
}

/* The cross that removes a row, or stops it if it is still going. */
DownloadRow .row-remove {
    min-width: 3;
    width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
    margin-left: 1;
}

DownloadRow .row-remove:hover {
    background: $error;
    color: $foreground;
}

DownloadRow.-done {
    border-left: outer $success;
}

DownloadRow.-done .row-title {
    color: $success;
}

DownloadRow.-done Bar > .bar--bar {
    color: $success;
}

DownloadRow.-failed {
    border-left: outer $error;
}

DownloadRow.-failed .row-title {
    color: $error;
}

DownloadRow.-failed .row-detail {
    color: $error;
}

/* One-shot highlight as a row lands. Removed on a timer, so nothing
   continues to animate afterwards. */
DownloadRow.-just-finished {
    background: $boost;
}

/* -- shared screen furniture -- */

#settings-body,
#history-body {
    padding: 0 4;
    height: 1fr;
}

#settings-title,
#history-title {
    text-style: bold;
    color: $accent;
    padding: 1 4 1 4;
    height: auto;
}

/* -- settings -- */

.setting {
    height: auto;
    margin-bottom: 1;
}

.setting Label {
    color: $text-muted;
}

.setting Input {
    border: tall $panel;
    background: $surface;
}

.setting Input:focus {
    border: tall $accent;
}

.setting-switch {
    height: auto;
    align-vertical: middle;
}

.setting-switch Label {
    margin-left: 1;
    color: $foreground;
    height: 3;
    content-align: left middle;
}

.field-error {
    color: $error;
    height: auto;
}

Input.-invalid {
    border: tall $error;
}

#settings-actions {
    height: auto;
    padding: 1 4 1 4;
    border-top: hkey $panel;
}

#settings-actions Button {
    margin-right: 2;
}

#settings-message {
    color: $warning;
    height: auto;
    padding: 0 4;
}

/* -- choosing a quality -- */

QualityScreen {
    align: center middle;
    background: $background 70%;
}

#quality-box {
    width: 60;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 3;
    background: $surface;
    border: thick $accent;
}

#quality-heading {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#quality-title {
    color: $text-muted;
    text-overflow: ellipsis;
}

/* How much more there is to get through, so a pasted list does not feel
   like an unknown number of questions. */
#quality-count {
    color: $text-muted;
    text-style: italic;
}

/* Spaced from above rather than below, so the gap is the same whether or
   not the count is showing. */
#quality-options {
    height: auto;
    max-height: 14;
    margin: 1 0;
}

#quality-rest {
    height: auto;
    align-vertical: middle;
    margin-bottom: 1;
}

#quality-rest Label {
    margin-left: 1;
    color: $text-muted;
    height: 3;
    content-align: left middle;
}

/* One line each, so the whole question -- every quality, the offer to
   answer for the rest, and the way out -- fits without scrolling. Bordered
   buttons took four lines apiece and pushed the controls off screen. */
.quality-option {
    width: 100%;
    height: 1;
    border: none;
    padding: 0 2;
    margin-bottom: 1;
    background: $panel;
    color: $foreground;
    text-align: left;
    content-align: left middle;
}

.quality-option:hover {
    background: $boost;
}

.quality-option:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

#quality-actions {
    height: auto;
}

/* -- history -- */

#history-tabs {
    height: 1fr;
}

#history-table,
#errors-table {
    height: 1fr;
    background: $surface;
}

.empty-note {
    color: $text-muted;
    text-style: italic;
    padding: 1 4;
    height: auto;
}

#history-back {
    margin: 1 4 1 4;
}
